[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/dungeon_complete.gd" id="script"]
[ext_resource type="Texture2D" path="res://sprites/Main-ui/crystal_emblem.png" id="crystal"]

[sub_resource type="StyleBoxFlat" id="panel"]
bg_color = Color(0.035, 0.07, 0.12, 0.98)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.2, 0.6, 0.8, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_left = 12
corner_radius_bottom_right = 12

[node name="DungeonComplete" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.012, 0.022, 0.045, 1)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(420, 300)
layout_mode = 2
theme_override_styles/panel = SubResource("panel")

[node name="Margin" type="MarginContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 16

[node name="Content" type="VBoxContainer" parent="Center/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 10
alignment = 1

[node name="Emblem" type="TextureRect" parent="Center/Panel/Margin/Content"]
custom_minimum_size = Vector2(48, 48)
layout_mode = 2
texture = ExtResource("crystal")
expand_mode = 1
stretch_mode = 5

[node name="Title" type="Label" parent="Center/Panel/Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.9, 1, 1)
theme_override_font_sizes/font_size = 27
text = "DUNGEON COMPLETE"
horizontal_alignment = 1

[node name="Description" type="Label" parent="Center/Panel/Margin/Content"]
layout_mode = 2
text = "The ancient guardians have fallen.\nYour spark endures."
horizontal_alignment = 1

[node name="BuffSummary" type="Label" parent="Center/Panel/Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.85, 1, 1)
horizontal_alignment = 1

[node name="Menu" type="Button" parent="Center/Panel/Margin/Content"]
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
text = "Return to Main Menu"

[node name="Quit" type="Button" parent="Center/Panel/Margin/Content"]
