[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/game_over.gd" id="script"]
[ext_resource type="Texture2D" path="res://sprites/Boost-UI/vitals_frame.svg" id="frame"]

[ext_resource type="Texture2D" path="res://scenes/background_concept.png" id="dungeon"]

[sub_resource type="StyleBoxTexture" id="panel"]
texture = ExtResource("frame")
texture_margin_left = 4
texture_margin_right = 4
texture_margin_top = 4
texture_margin_bottom = 4
content_margin_left = 24
content_margin_right = 24
content_margin_top = 16
content_margin_bottom = 16

[node name="GameOver" type="Control"]
process_mode = 3
texture_filter = 1
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("script")

[node name="Dungeon" type="TextureRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
texture_filter = 1
texture = ExtResource("dungeon")
expand_mode = 1
stretch_mode = 6
self_modulate = Color(0.48, 0.42, 0.54, 1)

[node name="Center" type="CenterContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Center"]
mouse_filter = 2
theme_override_styles/panel = SubResource("panel")

[node name="Options" type="VBoxContainer" parent="Center/Panel"]
mouse_filter = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Center/Panel/Options"]
mouse_filter = 2
horizontal_alignment = 1
theme_override_font_sizes/font_size = 20
theme_override_colors/font_color = Color(1, 0.71, 0.51, 1)
text = "Game Over"

[node name="Restart" type="Button" parent="Center/Panel/Options"]
unique_name_in_owner = true
text = "Restart"

[node name="MainMenu" type="Button" parent="Center/Panel/Options"]
unique_name_in_owner = true
text = "Main Menu"
